# Copy this file to .env in the repo root and edit it.
# Real environment variables override values in .env. Never commit .env.

# REQUIRED. SQLAlchemy connection string for the Postgres database that has the pgvector
# extension. Every pipeline stage that touches the database refuses to run without it.
DB_DSN=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/movies

# Optional. Defaults are shown commented out.

# Ollama model used to embed movie text and the watch history.
# EMBED_MODEL=nomic-embed-text

# Ollama model used to write the recommendation explanations.
# CHAT_MODEL=llama3.2

# Folder holding the IMDb TSV dumps. A relative path resolves against the repo root.
# IMDB_DIR=imdb_data
